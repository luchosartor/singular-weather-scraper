# Base URL for the Open-Meteo current weather forecast endpoint.
WEATHER_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Base URL for the Open-Meteo geocoding endpoint (used to resolve city names to coordinates).
WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# Timeout (seconds) for each outbound HTTP request.
WEATHER_REQUEST_TIMEOUT_SECONDS=10

# Max number of retries for transient HTTP failures (429/500/502/503/504).
WEATHER_MAX_RETRIES=3

# Backoff factor applied between retries (urllib3 Retry backoff_factor).
WEATHER_RETRY_BACKOFF_FACTOR=0.5

# Max outbound requests per second allowed by the rate limiter.
WEATHER_RATE_LIMIT_PER_SECOND=5

# Max number of concurrent worker threads fetching weather data.
WEATHER_MAX_CONCURRENT_WORKERS=5

# Directory where the CSV and chart outputs are written.
WEATHER_OUTPUT_DIR=output
